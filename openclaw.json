{
    "identity":  {
                     "name":  "AIMS营销助手",
                     "description":  "AI全员营销系统 - 覆盖电商运营/社媒营销/客服自动化/办公自动化"  // 系统身份标识，用于AI自我认知
                 },
    "gateway":  {
                    "mode":  "local",    // 运行模式: local(本地)/remote(远程)
                    "port":  18789,      // 网关监听端口
                    "bind":  "lan",      // 绑定地址: lan(局域网)/localhost(本机)
                    "auth":  {
                                 "mode":  "token",
                                 "token":  "${AIMS_GATEWAY_TOKEN}",
                                 "allowTailscale":  true
                             }
                },
    "agents":  {
                   "defaults":  {
                                    "workspace":  "D:/Project/aims/workspace",  // 默认工作目录
                                    "userTimezone":  "Asia/Shanghai",          // 用户时区
                                    "model":  {
                                                  "primary":  "deepseek/deepseek-chat",  // 主模型
                                                  "fallbacks":  [                     // 降级备用模型
                                                                    "moonshot/moonshot-v1-128k",
                                                                    "zhipu/glm-4-flash"
                                                                ]
                                              },
                                    "heartbeat":  {
                                                      "every":  "30m",
                                                      "target":  "last"
                                                  },
                                    "tools":  {
                                                  "profile":  "full",
                                                  "fs":  {
                                                             "workspaceOnly":  true
                                                         },
                                                  "elevated":  {
                                                                   "enabled":  false
                                                               }
                                              },
                                    "sandbox":  {
                                                    "mode":  "non-main",
                                                    "scope":  "agent"
                                                }
                                },
                   "list":  [
                                {
                                    "id":  "main",
                                    "default":  true,
                                    "workspace":  "D:/Project/aims/workspace-main",
                                    "identity":  {
                                                     "name":  "AIMS营销助手",
                                                     "theme":  "专业高效的AI全员营销系统",
                                                     "emoji":  "🦞"
                                                 }
                                },
                                {
                                    "id":  "ecommerce",
                                    "workspace":  "D:/Project/aims/workspace-ecommerce"
                                },
                                {
                                    "id":  "social-media",
                                    "workspace":  "D:/Project/aims/workspace-social"
                                },
                                {
                                    "id":  "cs",
                                    "workspace":  "D:/Project/aims/workspace-cs"
                                },
                                {
                                    "id":  "office",
                                    "workspace":  "D:/Project/aims/workspace-office"
                                }
                            ]
               },
    "models":  {
                   "mode":  "merge",
                   "providers":  {
                                     "deepseek":  {
                                                      "baseUrl":  "https://api.deepseek.com/v1",
                                                      "apiKey":  "${DEEPSEEK_API_KEY}",
                                                      "api":  "openai",
                                                      "models":  [
                                                                     {
                                                                         "id":  "deepseek-chat",
                                                                         "name":  "DeepSeek Chat",
                                                                         "reasoning":  false,
                                                                         "input":  [
                                                                                       "text"
                                                                                   ],
                                                                         "cost":  {
                                                                                      "input":  0.001,
                                                                                      "output":  0.002,
                                                                                      "cacheRead":  0,
                                                                                      "cacheWrite":  0
                                                                                  },
                                                                         "contextWindow":  64000,
                                                                         "maxTokens":  4096
                                                                     }
                                                                 ]
                                                  },
                                     "moonshot":  {
                                                      "baseUrl":  "https://api.moonshot.cn/v1",
                                                      "apiKey":  "${MOONSHOT_API_KEY}",
                                                      "api":  "openai",
                                                      "models":  [
                                                                     {
                                                                         "id":  "moonshot-v1-128k",
                                                                         "name":  "Moonshot V1 128K",
                                                                         "reasoning":  false,
                                                                         "input":  [
                                                                                       "text"
                                                                                   ],
                                                                         "cost":  {
                                                                                      "input":  0.012,
                                                                                      "output":  0.012,
                                                                                      "cacheRead":  0,
                                                                                      "cacheWrite":  0
                                                                                  },
                                                                         "contextWindow":  128000,
                                                                         "maxTokens":  8192
                                                                     }
                                                                 ]
                                                  },
                                     "zhipu":  {
                                                   "baseUrl":  "https://open.bigmodel.cn/api/paas/v4",
                                                   "apiKey":  "${ZHIPU_API_KEY}",
                                                   "api":  "openai",
                                                   "models":  [
                                                                  {
                                                                      "id":  "glm-4-flash",
                                                                      "name":  "GLM-4 Flash",
                                                                      "reasoning":  false,
                                                                      "input":  [
                                                                                    "text"
                                                                                ],
                                                                      "cost":  {
                                                                                   "input":  0.0001,
                                                                                   "output":  0.0001,
                                                                                   "cacheRead":  0,
                                                                                   "cacheWrite":  0
                                                                               },
                                                                      "contextWindow":  128000,
                                                                      "maxTokens":  4096
                                                                  }
                                                              ]
                                               }
                                 }
               },
    "bindings":  [
                     {
                         "agentId":  "office",
                         "match":  {
                                       "channel":  "feishu",
                                       "peer":  {
                                                    "kind":  "group",
                                                    "id":  "${FEISHU_OFFICE_GROUP_ID}"
                                                }
                                   }
                     },
                     {
                         "agentId":  "ecommerce",
                         "match":  {
                                       "channel":  "feishu",
                                       "accountId":  "bot1"
                                   }
                     },
                     {
                         "agentId":  "social-media",
                         "match":  {
                                       "channel":  "feishu",
                                       "accountId":  "bot2"
                                   }
                     },
                     {
                         "agentId":  "cs",
                         "match":  {
                                       "channel":  "wework"
                                   }
                     },
                     {
                         "agentId":  "main",
                         "match":  {
                                       "channel":  "*"
                                   }
                     }
                 ],
    "channels":  {
                     "defaults":  {
                                      "groupPolicy":  "allowlist"  // 群聊策略: allowlist(白名单)/open(开放)
                                  },
                     "feishu":  {
                                    "enabled":  true,
                                    "defaultAccount":  "bot1",
                                    "dmPolicy":  "pairing",
                                    "groupPolicy":  "allowlist",
                                    "requireMention":  true,
                                    "accounts":  {
                                                     "bot1":  {
                                                                  "appId":  "${FEISHU_BOT1_APP_ID}",
                                                                  "appSecret":  "${FEISHU_BOT1_APP_SECRET}",
                                                                  "name":  "AIMS电商助手",
                                                                  "enabled":  true
                                                              },
                                                     "bot2":  {
                                                                  "appId":  "${FEISHU_BOT2_APP_ID}",
                                                                  "appSecret":  "${FEISHU_BOT2_APP_SECRET}",
                                                                  "name":  "AIMS社媒助手",
                                                                  "enabled":  true
                                                              }
                                                 },
                                    "streaming":  true,
                                    "blockStreaming":  true,
                                    "typingIndicator":  false
                                },
                     "wework":  {
                                    "enabled":  true,
                                    "corpId":  "${WEWORK_CORP_ID}",
                                    "agentSecret":  "${WEWORK_AGENT_SECRET}",
                                    "dmPolicy":  "pairing"
                                },
                     "dingtalk":  {
                                      "enabled":  true,
                                      "appKey":  "${DINGTALK_APP_KEY}",
                                      "appSecret":  "${DINGTALK_APP_SECRET}",
                                      "dmPolicy":  "pairing"
                                  },
                     "telegram":  {
                                      "enabled":  true,
                                      "botToken":  "${TELEGRAM_BOT_TOKEN}",
                                      "dmPolicy":  "pairing",
                                      "allowFrom":  [
                                                        "${TELEGRAM_ALLOW_FROM}"
                                                    ],
                                      "groups":  {
                                                     "*":  {
                                                               "requireMention":  true
                                                           }
                                                 }
                                  },
                     "whatsapp":  {
                                      "enabled":  true,
                                      "dmPolicy":  "pairing",
                                      "allowFrom":  [
                                                        "${WHATSAPP_ALLOW_FROM}"
                                                    ],
                                      "groups":  {
                                                     "*":  {
                                                               "requireMention":  true
                                                           }
                                                 }
                                  },
                     "discord":  {
                                     "enabled":  true,
                                     "token":  "${DISCORD_TOKEN}",
                                     "dm":  {
                                                "enabled":  true
                                            }
                                 }
                 },
    "skills":  {
                   "load":  {
                                "watch":  true,
                                "watchDebounceMs":  250
                            },
                   "install":  {
                                   "nodeManager":  "npm"
                               },
                   "entries":  {
                                   "agent-health-optimizer":  {
                                                                  "enabled":  true
                                                              },
                                   "auto-updater-windows":  {
                                                                "enabled":  true
                                                            },
                                   "find-skills-skill":  {
                                                             "enabled":  true
                                                         },
                                   "skill-manager":  {
                                                         "enabled":  true
                                                     },
                                   "self-improvement":  {
                                                            "enabled":  true
                                                        },
                                   "skill-vetter":  {
                                                        "enabled":  true
                                                    },
                                   "listing-gen":  {
                                                       "enabled":  true
                                                   },
                                   "ad-optimizer":  {
                                                        "enabled":  true
                                                    },
                                   "review-mgr":  {
                                                      "enabled":  true
                                                  },
                                   "material-gen":  {
                                                        "enabled":  true
                                                    },
                                   "after-sale":  {
                                                      "enabled":  true
                                                  },
                                   "xhs-seed":  {
                                                    "enabled":  true
                                                },
                                   "douyin-ops":  {
                                                      "enabled":  true
                                                  },
                                   "opinion-watch":  {
                                                         "enabled":  true
                                                     },
                                   "order-query":  {
                                                       "enabled":  true
                                                   },
                                   "logistics-track":  {
                                                           "enabled":  true
                                                       },
                                   "doc-auto":  {
                                                    "enabled":  true
                                                },
                                   "brave-search":  {
                                                        "enabled":  true,
                                                        "env":  {
                                                                    "BRAVE_API_KEY":  "${BRAVE_API_KEY}"
                                                                }
                                                    },
                                   "tavily-search":  {
                                                         "enabled":  true,
                                                         "env":  {
                                                                     "TAVILY_API_KEY":  "${TAVILY_API_KEY}"
                                                                 }
                                                     },
                                   "nano-banana-pro":  {
                                                           "enabled":  true,
                                                           "env":  {
                                                                       "GEMINI_API_KEY":  "${GEMINI_API_KEY}"
                                                                   }
                                                       },
                                   "agent-browser":  {
                                                         "enabled":  true
                                                     },
                                   "summarize":  {
                                                     "enabled":  true
                                                 },
                                   "data-analyst-pro":  {
                                                            "enabled":  true
                                                        },
                                   "humanizer":  {
                                                     "enabled":  true
                                                 },
                                   "feishu-doc":  {
                                                      "enabled":  true,
                                                      "env":  {
                                                                  "FEISHU_APP_ID":  "${FEISHU_BOT1_APP_ID}",
                                                                  "FEISHU_APP_SECRET":  "${FEISHU_BOT1_APP_SECRET}"
                                                              }
                                                  },
                                   "rag-retrieval":  {
                                                         "enabled":  true,
                                                         "env":  {
                                                                     "MILVUS_HOST":  "${MILVUS_HOST}",
                                                                     "MILVUS_PORT":  "${MILVUS_PORT}"
                                                                 }
                                                     },
                                   "cross-drain":  {
                                                       "enabled":  true
                                                   },
                                   "email-mgr":  {
                                                     "enabled":  true
                                                 },
                                   "video-channel":  {
                                                         "enabled":  true
                                                     },
                                   "report-gen":  {
                                                      "enabled":  true
                                                  },
                                   "excel-viz":  {
                                                     "enabled":  true
                                                 },
                                   "intent-recognition":  {
                                                              "enabled":  true
                                                          },
                                   "sentiment-analysis":  {
                                                              "enabled":  true
                                                          },
                                   "confidence-gate":  {
                                                           "enabled":  true
                                                       },
                                   "user-profile":  {
                                                        "enabled":  true
                                                    },
                                   "smart-recommend":  {
                                                           "enabled":  true
                                                       },
                                   "multimodal-理解":  {
                                                         "enabled":  true
                                                     },
                                   "system-monitor":  {
                                                          "enabled":  true
                                                      },
                                   "agent-orchestrator":  {
                                                              "enabled":  true
                                                          },
                                   "skill-orchestrator":  {
                                                              "enabled":  true
                                                          },
                                   "mcp-framework":  {
                                                         "enabled":  true
                                                     },
                                   "knowledge-pipeline":  {
                                                              "enabled":  true
                                                          },
                                   "cron-engine":  {
                                                       "enabled":  true
                                                   },
                                   "data-layer":  {
                                                      "enabled":  true
                                                  },
                                   "security-guard":  {
                                                          "enabled":  true
                                                      },
                                   "skill-gate":  {
                                                      "enabled":  true
                                                  },
                                   "web-crawler":  {
                                                       "enabled":  true
                                                   },
                                   "data-flywheel":  {
                                                         "enabled":  true
                                                     },
                                   "meeting-minutes":  {
                                                            "enabled":  true
                                                        }
                               }
               },
    "session":  {
                    "dmScope":  "per-channel-peer",
                    "reset":  {
                                  "mode":  "daily",
                                  "atHour":  4,
                                  "idleMinutes":  120
                              }
                },
    "cron":  {
                 "enabled":  true,          // 是否启用定时任务
                 "maxConcurrentRuns":  3,   // 最大并发执行数
                 "jobs":  [
                             {
                                 "name":  "daily-ai-report",
                                 "schedule":  "0 9 * * *",
                                 "agentId":  "office",
                                 "task":  "生成AI行业日报",
                                 "description":  "每天9:00推送AI行业日报"
                             },
                             {
                                 "name":  "xhs-daily-publish",
                                 "schedule":  "0 10 * * *",
                                 "agentId":  "social-media",
                                 "task":  "生成并发布小红书种草内容",
                                 "description":  "每天10:00自动发布小红书种草内容"
                             },
                             {
                                 "name":  "douyin-daily-publish",
                                 "schedule":  "0 11 * * *",
                                 "agentId":  "social-media",
                                 "task":  "生成并发布抖音短视频",
                                 "description":  "每天11:00自动发布抖音内容"
                             },
                             {
                                 "name":  "video-channel-publish",
                                 "schedule":  "0 14 * * *",
                                 "agentId":  "social-media",
                                 "task":  "生成并发布视频号内容",
                                 "description":  "每天14:00自动发布视频号内容"
                             },
                             {
                                 "name":  "weekly-report",
                                 "schedule":  "0 18 * * 5",
                                 "agentId":  "office",
                                 "task":  "生成运营周报",
                                 "description":  "每周五18:00生成运营周报"
                             },
                             {
                                 "name":  "opinion-monitor",
                                 "schedule":  "*/10 * * * *",
                                 "agentId":  "social-media",
                                 "task":  "监控社媒舆情",
                                 "description":  "每10分钟监控社媒评论舆情"
                             },
                             {
                                 "name":  "team-daily-report",
                                 "schedule":  "0 8 * * *",
                                 "agentId":  "office",
                                 "task":  "生成团队日报",
                                 "description":  "每天8:00生成团队日报"
                             }
                         ]
             }
}
