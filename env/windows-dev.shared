# ===================================================
# aims 项目 - 本地 Windows 开发环境配置
# ===================================================
# 更新日期: 2026-05-05
# 说明: 基于本地 D:\aitools 环境配置，服务已安装并运行
# ===================================================

# ===================================================
# 1. 基础路径配置
# ===================================================
AIMS_TOOLS_ROOT=D:/aitools
AIMS_LOCAL_STORAGE_ROOT=D:/aitools/aims
AIMS_OLLAMA_DATA_DIR=D:/aitools/shared/ollama/models
AIMS_LOCAL_MODEL_CACHE_DIR=D:/aitools/aims/model-cache
AIMS_MYSQL_DATA_DIR=D:/aitools/shared/mysql/data
AIMS_REDIS_DATA_DIR=D:/aitools/shared/redis/data
AIMS_MINIO_DATA_DIR=D:/aitools/shared/minio/data
AIMS_QDRANT_DATA_DIR=D:/aitools/shared/qdrant/data
AIMS_PIP_CACHE_DIR=D:/aitools/shared/pip-cache

# ===================================================
# 2. 容器镜像配置 (本地开发可忽略)
# ===================================================
AIMS_OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
AIMS_OLLAMA_IMAGE=ollama/ollama:latest
AIMS_PYTHON_IMAGE=python:3.12-slim

# ===================================================
# 3. 服务端点与端口配置
# ===================================================
AIMS_GATEWAY_PORT=18789

# MySQL (MariaDB) 配置 - 已安装并运行
AIMS_MYSQL_HOST_PORT=3306
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=aims
MYSQL_USER=root
MYSQL_PASSWORD=

# Redis 配置 - 已安装并运行 (DB: 1)
AIMS_REDIS_HOST_PORT=6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# MinIO 配置 - 已安装并运行
AIMS_MINIO_API_PORT=9000
AIMS_MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aims-files
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Qdrant 向量数据库 - 已安装并运行
AIMS_QDRANT_HTTP_PORT=6333
AIMS_QDRANT_GRPC_PORT=6334
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_URL=http://127.0.0.1:6333

# Ollama LLM 服务 - 已安装并运行
AIMS_OLLAMA_HOST_PORT=11434
LLM_OLLAMA_ENDPOINT=http://127.0.0.1:11434
AIMS_DOCKER_OLLAMA_ENDPOINT=http://ollama-shared:11434
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434

# Milvus 配置 (备用向量数据库)
AIMS_MILVUS_GRPC_PORT=19530
AIMS_MILVUS_HEALTH_PORT=19091

# ===================================================
# 4. AI/ML 模型配置
# ===================================================
LLM_PRIMARY_MODEL=qwen2.5:1.5b-instruct
LLM_EMBEDDING_MODEL=bge-large-zh

# ===================================================
# 5. 安全配置
# ===================================================
AIMS_GATEWAY_TOKEN=aims-dev-token-2026
AIMS_OPENCLAW_CONFIG_PATH=./.generated/openclaw.runtime.json

# ===================================================
# 6. 日志与缓存目录
# ===================================================
LOG_DIR=D:/aitools/aims/logs
TEMP_DIR=D:/aitools/aims/temp
CACHE_DIR=D:/aitools/aims/cache

# ===================================================
# 7. 开发模式配置
# ===================================================
DEBUG=true
LOG_LEVEL=debug
